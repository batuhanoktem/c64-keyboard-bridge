# Copy to .env and edit privately. .env is ignored by Git.
# Precedence: CLI options > process environment > this file > defaults.
# Never place the network password in command arguments or commit it.

# Set your actual C64 Ultimate IPv4 address or hostname; do not include http://.
C64_HOST=
C64_PORT=80
# Single quotes preserve literal $, #, spaces, = and double quotes.
# If the password contains a single quote, use the double-quote escaping rules
# in docs/configuration.md. Empty is valid only when the device password is empty.
C64_NETWORK_PASSWORD=''

# Empty: infer the computer IPv4 address from its route to C64_HOST.
HOST_ADVERTISE_IP=
# Empty: bind to HOST_ADVERTISE_IP. Set a specific interface if needed.
BRIDGE_BIND_ADDRESS=
BRIDGE_PORT=6502
# Empty: allow IPv4 addresses resolved from C64_HOST; otherwise comma-separated.
C64_ALLOWED_IPS=

# Read-only device discovery on start. No deployment unless explicitly enabled.
AUTO_CONNECT=true
AUTO_DEPLOY=false

KEYBOARD_LAYOUT=US
KEYBOARD_PROFILE=modern
# Optional TOML profile; relative paths are relative to the current directory.
MAPPINGS_FILE=
INPUT_BACKEND=auto
REPEAT_DELAY_MS=500
REPEAT_INTERVAL_MS=40
LOG_LEVEL=info

# Empty: operating-system application data directory. Use a private directory.
BRIDGE_STATE_DIR=
